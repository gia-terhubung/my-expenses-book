# Tap positions (points) for the iPhone Duo outer display, closed (466 x 678 pt; content 382 wide,
# status column on the right). Source before capture-ios.sh.
# No OPEN_X: this simulator does not ask "Open in…?", and a blind tap would hit a receipt row.
export BOOT_WAIT=20
export X_MID=190 Y_SWIPE_FROM=520 Y_SWIPE_TO=380 X_PHOTO=190 Y_PHOTO=220
export X_SEARCH_TAB=122 Y_TABS=597 X_FIELD=140 Y_FIELD=40 Y_BLANK=400
export X_BLANK=430 Y_BLANK=400  # the status column: closes the keyboard, never hits a result
