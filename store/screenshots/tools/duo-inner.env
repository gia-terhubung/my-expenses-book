# Tap positions (points) for the iPhone Duo inner display, open and portrait (669 x 951 pt; icon
# rail on the left). No OPEN_X: this simulator does not ask "Open in…?". Source before capture-ios.sh.
export BOOT_WAIT=30 SCREEN_WAIT=16
export X_MID=360 Y_SWIPE_FROM=700 Y_SWIPE_TO=500 X_PHOTO=360 Y_PHOTO=300
export X_SEARCH_TAB=36 Y_TABS=202 X_FIELD=330 Y_FIELD=123 Y_BLANK=600
export X_BLANK=36 Y_BLANK=700  # empty rail below Settings
