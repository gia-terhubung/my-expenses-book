# Tap positions (points) for the iPhone Duo inner display, open and held sideways (951 x 669 pt;
# list on the left, detail on the right, tabs in the side column on the right). Capture with
# ROTATE=landscape. No OPEN_X: this simulator does not ask "Open in…?". Source before capture-ios.sh.
export BOOT_WAIT=30 SCREEN_WAIT=12 ROTATE=landscape
export X_MID=290 Y_SWIPE_FROM=500 Y_SWIPE_TO=500   # the review sheet shows the whole receipt: no scroll
export X_PHOTO=290 Y_PHOTO=380                      # receipt photo in the review sheet
export HOME_ROW_X=95 HOME_ROW_Y=372                 # first receipt, so the detail pane is not empty
export TRIP_ROW_X=95 TRIP_ROW_Y=388                 # the hotel row in the trip folder
export X_FIELD=652 Y_FIELD=49                       # native search field in the header
export SEARCH_ROW_X=122 SEARCH_ROW_Y=239            # first search result
export X_BLANK=905 Y_BLANK=330                      # side column between the Filter button and the tabs
