# Tap positions (points) for the iPad Pro 13" portrait layout with native tabs (1032 x 1376 pt; tab
# bar at the top, list left, detail right). Source before capture-ios.sh.
export BOOT_WAIT=20 OPEN_X=591 OPEN_Y=700           # "Open in My Expenses Book?" alert: Open
export HOME_ROW_X=first TRIP_ROW_X=first SEARCH_ROW_X=first  # first list row, found by its label
export X_MID=750 Y_SWIPE_FROM=900 Y_SWIPE_TO=900    # the review sheet shows the whole receipt: no scroll
export X_PHOTO=photo                               # receipt photo, found by its label
export X_FIELD=1000 Y_FIELD=54                      # the search button that opens the search field
export X_BLANK=700 Y_BLANK=1200                     # empty detail pane: closes the keyboard
export REBOOT=springboard                           # status bar date in the capture language
